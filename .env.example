# Frontend (safe to expose only variables prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API_URL is server-only. NEXT_PUBLIC_API_URL is accepted only outside production
# during migration and must not be configured on production.
API_URL=http://localhost:8000/api/v1
# Server-only origin credential shared by Next.js and Django. Leave blank for
# local development; use at least 32 random ASCII bytes outside local.
NISKALA_BFF_SHARED_SECRET=
NISKALA_PUBLIC_HOSTS=localhost
NISKALA_CLIENT_HOSTS=localhost
NISKALA_STAFF_HOSTS=localhost
NISKALA_API_HOSTS=localhost
NEXT_PUBLIC_DEFAULT_LOCALE=id
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_WHATSAPP_NUMBER=6281997452212
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Django
DJANGO_SECRET_KEY=change-me-in-local-development
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_DOMAIN=
DJANGO_CSRF_COOKIE_DOMAIN=
DJANGO_API_DOCS_ENABLED=true
DJANGO_MAX_REQUEST_BYTES=2097152
DJANGO_SESSION_COOKIE_AGE=28800
STAFF_MFA_REQUIRED=false
STAFF_MFA_CHALLENGE_TTL_SECONDS=300
STAFF_MFA_REAUTH_TTL_SECONDS=1800
STAFF_SESSION_ABSOLUTE_TTL_SECONDS=28800
STAFF_SESSION_IDLE_TTL_SECONDS=1800
STAFF_SESSION_TOUCH_INTERVAL_SECONDS=60
PUBLIC_SITE_URL=http://localhost:3000
CLIENT_SITE_URL=http://localhost:3000
STAFF_SITE_URL=http://localhost:3000
# Required only in production; pin generated capability URLs and API host to the
# intended trust zones so a typo cannot redirect secrets to an unrelated host.
PRODUCTION_EXPECTED_PUBLIC_ORIGIN=
PRODUCTION_EXPECTED_CLIENT_ORIGIN=
PRODUCTION_EXPECTED_STAFF_ORIGIN=
PRODUCTION_EXPECTED_API_HOST=
PRODUCTION_EXPECTED_DATABASE_HOST=
PRODUCTION_EXPECTED_DATABASE_DIRECT_HOST=
PRODUCTION_EXPECTED_DATABASE_NAME=
PRODUCTION_EXPECTED_REDIS_HOST=
PRODUCTION_EXPECTED_CLOUDINARY_CLOUD_NAME=
CAPABILITY_KEYS_JSON={"local":"local-development-capability-key-do-not-use-in-production"}
CAPABILITY_PRIMARY_KEY_ID=local
LEGACY_INVITATION_LINKS_ENABLED=false
LEGACY_INVITATION_LINK_CUTOFF=
CLIENT_ACCESS_COOKIE_NAME=niskala_client
GUEST_ACCESS_COOKIE_NAME=niskala_guest
PREVIEW_ACCESS_COOKIE_NAME=niskala_preview
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding
DATABASE_DIRECT_URL=postgresql://wedding:wedding@localhost:5432/wedding
DATABASE_DISABLE_SERVER_SIDE_CURSORS=true

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Integrations
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=5
OPEN_METEO_CACHE_TTL_SECONDS=21600
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_MESSAGE_TEMPLATE_ID=Halo, saya tertarik dengan undangan pernikahan digital Anda.
WHATSAPP_MESSAGE_TEMPLATE_EN=Hello, I am interested in your digital wedding invitation service.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Runtime
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60
