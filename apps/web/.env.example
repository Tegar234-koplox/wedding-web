# Server-only credentials for a Cloudflare Access protected API. Never prefix
# these variables with NEXT_PUBLIC_. Configure both or neither.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Server-only origin credential. Staging/production must use the exact same
# strong value configured on Django. Never prefix this with NEXT_PUBLIC_.
NISKALA_BFF_SHARED_SECRET=
