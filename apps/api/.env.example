DJANGO_SECRET_KEY=change-me-in-local-development
DJANGO_SETTINGS_MODULE=config.settings.local
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_RELEASE=local
# Server-only origin credential shared only with the Next.js runtime. Generate
# at least 32 random ASCII bytes for staging/production; never use NEXT_PUBLIC_.
NISKALA_BFF_SHARED_SECRET=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_DOMAIN=
DJANGO_CSRF_COOKIE_DOMAIN=
PUBLIC_SITE_URL=http://localhost:3000
CLIENT_SITE_URL=http://localhost:3000
STAFF_SITE_URL=http://localhost:3000
PRODUCTION_EXPECTED_PUBLIC_ORIGIN=
PRODUCTION_EXPECTED_CLIENT_ORIGIN=
PRODUCTION_EXPECTED_STAFF_ORIGIN=
PRODUCTION_EXPECTED_API_HOST=
PRODUCTION_EXPECTED_DATABASE_HOST=
PRODUCTION_EXPECTED_DATABASE_DIRECT_HOST=
PRODUCTION_EXPECTED_DATABASE_NAME=
PRODUCTION_EXPECTED_REDIS_HOST=
PRODUCTION_EXPECTED_CLOUDINARY_CLOUD_NAME=
CAPABILITY_KEYS_JSON={"local":"local-development-capability-key-do-not-use-in-production"}
CAPABILITY_PRIMARY_KEY_ID=local
LEGACY_INVITATION_LINKS_ENABLED=false
LEGACY_INVITATION_LINK_CUTOFF=
CLIENT_ACCESS_COOKIE_NAME=niskala_client
GUEST_ACCESS_COOKIE_NAME=niskala_guest
PREVIEW_ACCESS_COOKIE_NAME=niskala_preview
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding
DATABASE_DIRECT_URL=postgresql://wedding:wedding@localhost:5432/wedding
DATABASE_DISABLE_SERVER_SIDE_CURSORS=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=5
OPEN_METEO_CACHE_TTL_SECONDS=21600
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_MESSAGE_TEMPLATE_ID=
WHATSAPP_MESSAGE_TEMPLATE_EN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60

# Required only when DEPLOYMENT_ENVIRONMENT=staging. These values are guards,
# not credentials; they must describe the dedicated staging resources exactly.
STAGING_EXPECTED_FRONTEND_ORIGIN=https://staging.niskalastudio.site
STAGING_EXPECTED_CLIENT_ORIGIN=https://client-staging.niskalastudio.site
STAGING_EXPECTED_STAFF_ORIGIN=https://staff-staging.niskalastudio.site
STAGING_EXPECTED_API_HOST=api-staging.niskalastudio.site
STAGING_EXPECTED_DATABASE_HOST=
STAGING_EXPECTED_DATABASE_DIRECT_HOST=
STAGING_EXPECTED_DATABASE_NAME=
STAGING_EXPECTED_REDIS_HOST=
STAGING_EXPECTED_CLOUDINARY_CLOUD_NAME=
STAGING_DEMO_STAFF_PASSWORD=
STAGING_DEMO_MFA_KEY=
